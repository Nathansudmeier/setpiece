{
  "name": "setpiece",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run test && npm run build",
    "test:billing:sql": "node --test --test-concurrency=1 tests/billing/database.test.mjs tests/billing/lifecycle.test.mjs tests/billing/security.test.mjs tests/billing/outbox.test.mjs tests/billing/concurrency.test.mjs tests/billing/numbering.test.mjs",
    "test:billing:pdf": "tsx --test tests/billing/pdf.test.mjs tests/billing/recovery.test.mjs",
    "test:billing:browser": "node scripts/billing/browser-acceptance.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.110.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "fflate": "0.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.18.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": ">=0.35.5"
  }
}
